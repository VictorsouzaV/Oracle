-- DECLARE --
Usamos para a declaração de variáveis
Ex:
    nome VARCHAR2(50);
    apelido VARCHAR2(50);

-- BEGIN --
Para programação lógica
Ex:
    nome := 'João Silva';

-- EXCEPTION --
Tratamento de exceções durante a execução, para cada erro, existe um tratamento
Ex:
    exception
        when no_data_found then
            dbms_output.put_line('Departamento não cadastrado!');

-- DBMS --
Esse comando tem como objetivo imprimir o resultado na tela
Ex:
    dbms_output.put() -- imprime e não pula linha
    dbms_output.put_line() -- imprime e pula linha

-- TYPE --
Usamos esse comando para declarar uma variável com tipo de dado
de uma coluna ou variável
Ex:
    w_cod emp.empcod%TYPE := sysdate;
    w_nome emp.empnome%TYPE := 'Ze marcos';

-- IF, ELSIF, ELSE, END IF --
Esse conjunto de comandos faz parte da estrutura condicional if
Ex:
    if valor > 0 then
        msg := 'Valor maior que zero';

    elsif valor = 0 then
        msg := 'Valor igual a zero';

    else
        msg := 'Valor menor que zero';

    end if;

-- MOD --
Comando usado para retornar o resto da divisão
Ex:
    if mod(numero, 2) = 0 then -- aqui testamos se o resto da divisão vai ser igual a 0

-- OPERADORES DE COMPARAÇÃO --
São esses: <, >, <=, >=, <>, e =
Ex:
    if (idade > 18) then
        -- bloco de execução --

    elsif (idade < 18) then
        -- bloco de execução --
    
    end if;

-- OPERADORES LÓGICOS --
São esses: and, or, not
Ex:
    if (idade >= 16) and (idade < 20) then
        -- bloco de execução --

    else
        -- bloco de execução --

-- & --
O & (comercial) serve para entrada de valores no oracle
Ex:
    num1 number := &n1;
    num2 number := &n2;

-- CURSOR --
O cursor declara a consulta que será percorrida, necessário quando o select retorna várias linhas
Ex:
    cursor c_funcionarios is
    select id, nome, salario
    from c_funcionarios
    where departamento_id = 10;

-- OPEN --
Executa a consulta do cursor e prepara o conjunto de resultados
Ex:
    open c_funcionarios;

-- FETCH --
Busca a próxima linha do cursor e coloca os valores em variáveis
Ex:
    fetch c_funcionarios into v_id, v_nome, v_salario;

-- CLOSE --
Fecha o cursor e libera a memória
Ex:
    close c_funcionarios;

-- %ROWTYPE --
Cria uma variável (registro) com a mesma estrutura de uma linha de uma tabela ou do cursor
Ex:
    v_func c_funcionarios%ROWTYPE -- baseado na tabela --
    v_reg c_funcionarios%ROWTYPE -- baseado no cursor --

-- Dúvidas da aula de hoje --
-- NEXTVAL --
O comando NEXTVAL permite fazer auto incremento (soma + 1)
Ex: 
    :new.id_cliente := seq_cliente.NEXTVAL

-- SEQUENCE --
Esse comando usamos com create, para criarmos uma sequência
Ex: 
    create sequence seq_cliente start with 1;

-- TRIGGER --
O comando trigger atua de forma automatica, podendo validar dados, preencher valores automaticamente
Ex:
    create or replace trigger nome_trigger
    before insert on tabela_cliente
    for each row

    begin
        :new.id_cliente := seq_cliente.NEXTVAL;

-- SYSDATE --
Retorna a data e a hora atuais do servidor do banco de dados Oracle.
Pode ser usado para registrar quando um dado foi criado ou alterado.
Ex:
    select sysdate from dual;

Também pode ser usado em um bloco PL/SQL:
    data_atual DATE := sysdate;

Em um trigger:
    :new.data_criacao := sysdate;

Observação: SYSDATE usa o relógio e o fuso horário do servidor do banco,
e não necessariamente o relógio do computador do usuário.