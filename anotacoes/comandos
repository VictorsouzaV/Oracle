-- DECLARE --
Usamos para a declaração de variáveis
Ex:
    nome VARCHAR2(50);
    apelido VARCHAR2(50);

-- BEGIN --
Para programação lógica
Ex:
    nome := 'João Silva';

-- EXCEPTION --
Tratamento de exceções durante a execução, para cada erro, existe um tratamento
Ex:
    exception
        when no_data_found then
            dbms_output.put_line('Departamento não cadastrado!');

-- DBMS --
Esse comando tem como objetivo imprimir o resultado na tela
Ex:
    dbms_output.put() -- imprime e não pula linha
    dbms_output.put_line() -- imprime e pula linha

-- TYPE --
Usamos esse comando para declarar uma variável com tipo de dado
de uma coluna ou variável
Ex:
    w_cod emp.empcod%TYPE := sysdate;
    w_nome emp.empnome%TYPE := 'Ze marcos';

-- IF, ELSIF, ELSE, END IF --
Esse conjunto de comandos faz parte da estrutura condicional if
Ex:
    if valor > 0 then
        msg := 'Valor maior que zero';

    elsif valor = 0 then
        msg := 'Valor igual a zero';

    else
        msg := 'Valor menor que zero';

    end if;

-- MOD --
Comando usado para retornar o resto da divisão
Ex:
    if mod(numero, 2) = 0 then -- aqui testamos se o resto da divisão vai ser igual a 0

-- OPERADORES DE COMPARAÇÃO --
São esses: <, >, <=, >=, <>, e =
Ex:
    if (idade > 18) then
        -- bloco de execução --

    elsif (idade < 18) then
        -- bloco de execução --
    
    end if;

-- OPERADORES LÓGICOS --
São esses: and, or, not
Ex:
    if (idade >= 16) and (idade < 20) then
        -- bloco de execução --

    else
        -- bloco de execução --

-- & --
O & (comercial) serve para entrada de valores no oracle
Ex:
    num1 number := &n1;
    num2 number := &n2;